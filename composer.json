{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "parsa-zabihi/appointment-api",
  "type": "project",
  "description": "Portfolio-grade Laravel 13 appointment booking API with PostgreSQL, Redis locks/cache, queues, scheduler, payments and webhooks.",
  "keywords": ["laravel", "booking", "appointments", "postgresql", "redis", "api"],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "@php artisan db:seed --force"
    ],
    "test": ["@php artisan config:clear --ansi @no_additional_args", "@php artisan test"],
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "post-root-package-install": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\""]
  },
  "extra": {"laravel": {"dont-discover": []}},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}
